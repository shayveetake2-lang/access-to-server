<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-s
    RewriteCond %{REQUEST_URI} !\.view$
    # some subsonic clients don't use *.view
    RewriteRule ^(.+)$ /ampache/public/rest/index.php?ssaction=$1 "[PT,L,QSA,B= ?,BNP]"
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-s
    # subsonic clients using *.view
    RewriteRule ^(.+)\.view$ /ampache/public/rest/index.php?ssaction=$1 "[PT,L,QSA,B= ?,BNP]"
    RewriteRule ^fake/(.+)$ /ampache/public/play/$1 "[PT,L,QSA,B= ?,BNP]"
</IfModule>
