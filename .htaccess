# /Volumes/htdocs/access-to-server/.htaccess
# Secure Web Application Environment Configuration

# Disable Directory Indexing
Options -Indexes

# =========================================================
# Apache Basic Authentication for Diagnostic & Admin Tools
# =========================================================
<FilesMatch "^(auto_debug\.php|debug\.php|test_db\.php|db_setup\.php)$">
    AuthType Basic
    AuthName "Restricted Internal Diagnostic Tools - Authentication Required"
    AuthUserFile /Volumes/htdocs/access-to-server/.htpasswd
    Require valid-user
</FilesMatch>

# Block all access to .git metadata directory and contents
RedirectMatch 404 (^|/)\.git

# Protect Sensitive Configuration, Database, Backup, and Script Files
<FilesMatch "\.(sqlite|sqlite3|db|sql|env|htpasswd|log|sh|ini|bak|conf)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config\.php|db_connect\.php|ampache\.cfg\.php)$">
    Require all denied
</FilesMatch>
