# /Volumes/htdocs/access-to-server/.htaccess
# Secure Web Application Environment Configuration

# Disable Directory Indexing
Options -Indexes

# =========================================================
# Apache Basic Authentication for Diagnostic & Admin Tools
# =========================================================
<FilesMatch "^(auto_debug\.php|debug\.php|test_db\.php|db_setup\.php)$">
    AuthType Basic
    AuthName "Restricted Internal Diagnostic Tools - Authentication Required"
    AuthUserFile /Volumes/htdocs/access-to-server/.htpasswd
    Require valid-user
</FilesMatch>

# Protect Sensitive Configuration Files
<FilesMatch "^(\.env|\.git|config\.php|db_connect\.php|\.htpasswd)$">
    Require all denied
</FilesMatch>
