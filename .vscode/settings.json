{
    "git.autorefresh": false,
    "git.autofetch": false,
    "git.decorations.enabled": true,
    "git.detectSubmodules": false,
    "git.status.submodules": false,
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/sites/**": true
    },
    "git.ignoreLimitWarning": true,
    "python.defaultInterpreterPath": "/Applications/Xcode.app/Contents/Developer/usr/bin/python3"
}
